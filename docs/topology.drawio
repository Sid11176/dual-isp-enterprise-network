ne;html=1;strokeWidth=2;strokeWidth=1;" edge="1" parent="1" source="c14" target="c78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c80" value="PC-BR-STAFF&lt;br&gt;VLAN 110 · Fa0/1" style="shape=mxgraph.cisco.computers_and_peripherals.pc;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1141" y="668" width="48" height="44" as="geometry"/></mxCell><mxCell id="c81" style="endArrow=none;html=1;strokeWidth=2;strokeWidth=1;" edge="1" parent="1" source="c15" target="c80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c82" value="PC-BR-GUEST&lt;br&gt;VLAN 140 · Fa0/2" style="shape=mxgraph.cisco.computers_and_peripherals.pc;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1251" y="668" width="48" height="44" as="geometry"/></mxCell><mxCell id="c83" style="endArrow=none;html=1;strokeWidth=2;strokeWidth=1;" edge="1" parent="1" source="c15" target="c82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c84" value="AP-STAFF&lt;br&gt;VLAN 110 · Fa0/3&lt;br&gt;(Phase 7)" style="shape=mxgraph.cisco.wireless.access_point;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1359" y="670" width="52" height="40" as="geometry"/></mxCell><mxCell id="c85" style="endArrow=none;html=1;strokeWidth=2;strokeWidth=1;" edge="1" parent="1" source="c15" target="c84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c86" value="AP-GUEST&lt;br&gt;VLAN 140 · Fa0/4&lt;br&gt;(Phase 7)" style="shape=mxgraph.cisco.wireless.access_point;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1469" y="670" width="52" height="40" as="geometry"/></mxCell><mxCell id="c87" style="endArrow=none;html=1;strokeWidth=2;strokeWidth=1;" edge="1" parent="1" source="c15" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;HQ VLANs&lt;/b&gt; (HSRP group = VLAN ID, VIP first usable, R1 .2 / R2 .3 pattern)&lt;br&gt;10 USERS 10.10.0.0/25 · 20 ADMIN 10.10.0.128/26 · 30 IT 10.10.0.192/27 · 40 GUEST 10.10.1.0/27&lt;br&gt;50 SERVERS 10.10.1.32/28 (VIP .33) · 99 MGMT 10.10.1.48/28 (VIP .49, routers .52/.53)&lt;br&gt;Native 998, parking 999. NAT pool: R1 192.0.2.1, R2 192.0.2.2. Our prefix: 192.0.2.0/24" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="790" width="920" height="90" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;Branch VLANs&lt;/b&gt; (gateway on BR-R1)&lt;br&gt;110 BR-STAFF 10.10.2.0/25 · 140 BR-GUEST 10.10.2.128/26&lt;br&gt;199 BR-MGMT 10.10.2.192/28&lt;br&gt;PAT on Gi0/1 (198.51.100.10)" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="790" width="490" height="90" as="geometry"/></mxCell><mxCell id="c90" value="Routing: OSPF area 0 HQ only. eBGP only (no iBGP in Packet Tracer). INET prefers ISP-A because the ISP-B path crosses ISP-B-UP (one extra AS hop). Floating static default on each HQ router via the other covers an ISP failure." style="text;html=1;whiteSpace=wrap;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="430" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>